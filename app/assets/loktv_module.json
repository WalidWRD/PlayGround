{
  "module_id": "LOKTV-HOOK-PRO",
  "module_name": "LOKTV Hook Pro",
  "version": "2.1.0",
  "version_code": 210,
  "build_tag": "2026.10.07-r2",
  "min_sdk": 21,
  "target_sdk": 34,
  "entry_point": "com.loktv.hook.LokTvHook",
  "targets": ["com.novan.morpha"],
  "target_aliases": ["com.novan.morpha", "com.novan", "morpha", "novan"],
  "frameworks": ["LSPatch", "NPatch", "HKP-Patch", "LSPosed", "EdXposed"],
  "requires_root": false,
  "features": [
    {"id": "F01", "name": "VIP / Premium unlock", "hook": "UserStatus#isVip -> true + level 9999 / expiry far-future"},
    {"id": "F02", "name": "Skip forced update", "hook": "isSkipUpdate -> true; isForceUpdate/hasUpdate/needUpdate -> false"},
    {"id": "F03", "name": "Valid collection unlock", "hook": "UserStatus#isValidCollection -> true"},
    {"id": "F04", "name": "Video data channel unlock", "hook": "UserStatus#isVideoDataEnabled -> true"},
    {"id": "F05", "name": "Popup suppressor", "hook": "UserStatus#DisableSomePopup -> no-op"},
    {"id": "F06", "name": "Tamper/root/emulator/signature neutralizer", "hook": "*modded/root/tamper/signature/emulator/xposed/frida -> false/empty"},
    {"id": "F07", "name": "Anti-VPN bypass", "hook": "AntiVPN#* -> false / empty + method-name heuristic"},
    {"id": "F08", "name": "Floating overlay disabler", "hook": "FloatingView#* -> no-op + simple-name fallback"},
    {"id": "F09", "name": "Screen rotation controller", "hook": "GetRotation#* -> configured value"},
    {"id": "F10", "name": "Dex-wide class scanner", "hook": "boolean/int/long heuristic resolver"},
    {"id": "F11", "name": "Packed APK support", "hook": "attachBaseContext/onCreate loader capture + delayed retry"},
    {"id": "F12", "name": "Crash guard", "hook": "isolated steps + full-stack origin check"},
    {"id": "F13", "name": "Runtime log", "hook": "logcat + app-private file"},
    {"id": "F14", "name": "Hot configuration", "hook": "loktv_hook.conf key=value (validated)"},
    {"id": "F15", "name": "Ads/splash/banner/reward block", "hook": "ad gates -> false, show/load -> no-op"},
    {"id": "F16", "name": "Tracker disabler", "hook": "analytics/track/report/log -> no-op"},
    {"id": "F17", "name": "Update dialog block", "hook": "showUpdate/showNotice/dialog -> no-op/false"}
  ],
  "config_file": "loktv_hook.conf",
  "config_keys": ["vip","skip_update","valid_collection","video_data","disable_popup","anti_detect","anti_vpn","floating_view","generic_scanner","ads_block","tracker_block","update_dialog","rotation","debug"],
  "log_file": "loktv_hook.log"
}
