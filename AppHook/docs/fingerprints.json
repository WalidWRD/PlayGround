{
  "module": "AppHook",
  "version": "3.1.0",
  "scope": ["ai.mainfunc.genspark", "ai.mainfunc.genspark.test"],
  "note": "Fingerprint DB — read instead of re-analyzing. Runtime matches by signature, not fixed names.",
  "fingerprints": [
    {"feature": "billing-state", "class": "com.android.billingclient.api.Purchase", "method": "getPurchaseState", "return": "int", "args": 0, "action": "force 0", "stability": "stable PBLv5-v8", "fallback": "getPurchase*->int/0args"},
    {"feature": "billing-ack", "class": "com.android.billingclient.api.Purchase", "method": "isAcknowledged", "return": "boolean", "args": 0, "action": "force true", "stability": "stable"},
    {"feature": "billing-ready", "class": "com.android.billingclient.api.BillingClient", "method": "isReady", "return": "boolean", "args": 0, "action": "force true", "stability": "stable"},
    {"feature": "billing-query", "class": "com.android.billingclient.api.BillingClient", "method": "queryPurchasesAsync", "return": "any", "args": "any", "action": "watch", "stability": "stable", "risk": "PBLv9 signature change -> match by name only"},
    {"feature": "billing-list", "class": "com.android.billingclient.api.Purchase$PurchasesResult", "method": "getPurchasesList", "return": "List", "args": 0, "action": "watch", "stability": "stable"},
    {"feature": "revenuecat-active", "class": "com.revenuecat.purchases.EntitlementInfo", "method": "isActive", "return": "boolean", "args": 0, "action": "force true", "stability": "stable", "fallback": "active->boolean/0args"},
    {"feature": "revenuecat-issue", "class": "com.revenuecat.purchases.EntitlementInfo", "method": "getBillingIssueDetectedAt", "return": "Date", "args": 0, "action": "force null", "stability": "stable", "fallback": "billingIssue*/0args"},
    {"feature": "premium-flags", "class": "<pkg>.UserInfo|User|model.User|data.User|*Manager", "method": "isPremium|isVip|isPro|isSubscribed|hasPremium|...", "return": "boolean|int", "args": 0, "action": "true|1", "stability": "R8-sensitive", "fallback": "scanPremiumFlags() full-class sweep"},
    {"feature": "okhttp-body", "class": "okhttp3.Response", "method": "body", "return": "ResponseBody", "args": 0, "action": "watch", "stability": "R8-sensitive"},
    {"feature": "okhttp-call", "class": "okhttp3.RealCall", "method": "execute", "return": "Response", "args": 0, "action": "watch", "stability": "stable"},
    {"feature": "http-conn", "class": "java.net.HttpURLConnection", "method": "getResponseCode", "return": "int", "args": 0, "action": "watch (do NOT force 200)", "stability": "stable"},
    {"feature": "integrity", "class": "com.google.android.play.core.integrity.IntegrityManager", "method": "*integritytoken*", "return": "any", "args": "any", "action": "watch", "stability": "R8-sensitive"},
    {"feature": "flutter-invoke", "class": "io.flutter.plugin.common.MethodChannel", "method": "invokeMethod", "return": "void", "args": 3, "action": "watch + count premium queries", "stability": "stable", "fallback": "match by name+3args"},
    {"feature": "flutter-handler", "class": "io.flutter.plugin.common.MethodChannel", "method": "setMethodCallHandler", "return": "void", "args": 1, "action": "proxy handler+result (success->true/1/map-patch)", "stability": "stable", "fallback": "prefs+json layers"},
    {"feature": "prefs-bool", "class": "android.app.SharedPreferencesImpl", "method": "getBoolean", "return": "boolean", "args": 2, "action": "force true on premium keys", "stability": "stable", "fallback": "interface watch"},
    {"feature": "prefs-int", "class": "android.app.SharedPreferencesImpl", "method": "getInt", "return": "int", "args": 2, "action": "force 1 on premium keys (0->1)", "stability": "stable"},
    {"feature": "gson", "class": "com.google.gson.Gson", "method": "fromJson", "return": "T", "args": 2, "action": "patch subscription fields", "stability": "stable", "fallback": "org.json"},
    {"feature": "orgjson", "class": "org.json.JSONObject", "method": "getBoolean", "return": "boolean", "args": 1, "action": "force true on premium keys", "stability": "stable"},
    {"feature": "dex-scan", "class": "<app-dex>", "method": "entries()", "return": "candidate classes", "args": 0, "action": "log premium|vip|subscription|billing|purchase|entitlement matches (cap 200)", "stability": "stable"},
    {"feature": "webview-jsbridge", "class": "android.webkit.WebView", "method": "addJavascriptInterface", "return": "void", "args": 2, "action": "watch bridge names", "stability": "stable"},
    {"feature": "webview-intercept", "class": "android.webkit.WebViewClient", "method": "shouldInterceptRequest", "return": "WebResourceResponse", "args": 2, "action": "watch pay URLs only (both overloads)", "stability": "stable"},
    {"feature": "appsflyer", "class": "com.appsflyer.AppsFlyerLib", "method": "logEvent", "return": "any", "args": "any", "action": "watch purchase/subscribe events", "stability": "R8-sensitive", "fallback": "hookAll by name"},
    {"feature": "urlconn-stream", "class": "java.net.HttpURLConnection", "method": "getInputStream", "return": "InputStream", "args": 0, "action": "watch URL (dart:io via JNI)", "stability": "stable"}
  ],
  "breakage_watch": [
    {"priority": "P0", "point": "RealInterceptorChain.proceed (internal)", "fail_sign": "internal absent / signature differs", "alt": "optional only - does not block unlock"},
    {"priority": "P0", "point": "MethodChannel.setMethodCallHandler", "fail_sign": "signature differs", "alt": "fallback to PrefsHook + JsonHook"},
    {"priority": "P1", "point": "Gson.fromJson(String,Class)", "fail_sign": "signature differs", "alt": "hook org.json"},
    {"priority": "P1", "point": "SharedPreferencesImpl.getBoolean", "fail_sign": "impl absent", "alt": "watch getAll()/interface + channel"},
    {"priority": "P2", "point": "Purchase.getPurchaseState (PBL v9)", "fail_sign": "method-not-found", "alt": "rely on channel hook"},
  ]
}
